#include <stdio.h>

int main() {
    char input;
    printf("Enter a character: ");
    scanf("%c", &input);

    if (input >= 'a' && input <= 'z') {
        printf("Lowercase letter\n");
    } else if (input >= 'A' && input <= 'Z') {
        printf("Uppercase letter\n");
    } else if (input >= '0' && input <= '9') {
        printf("Digit\n");
    } else {
        printf("Special character\n");
    }

    return 0;
}
